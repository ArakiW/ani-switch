NOTE: this patch is INCOMPLETE.  The hardcoded IP table is also
referenced inline in `_cpr_post` (around L304 in the v19.0.1
http.cpp) and `_cpr_get` (around L388), not just in
`rewriteUrlForIP`.  After `git apply`-ing the two hunks above,
you must also manually clean those two callers; otherwise
compilation will fail with:

    undefined reference to `lookupHardcodedHost(char const*)'

The inline pattern in both callers looks like this in v19.0.1:

    const char* hardcoded = lookupHardcodedHost(host.c_str());
    char ipBuf[32] = {0};
    const char* ip = nullptr;
    if (hardcoded) {
        ip = hardcoded;
        snprintf(_b, sizeof(_b), "HTTP: RESOLVE %s -> %s (hardcoded)",
                 host.c_str(), ip);
        aniswitchStartupLog(_b);
    } else {
        if (aniswitchResolveHost(host.c_str(), ipBuf, sizeof(ipBuf)) == 0) {
            ip = ipBuf;
            ...
        }
    }
    if (ip) {
        // then session->SetResolve(...)
    }

Replace both blocks with the unconditional `aniswitchResolveHost` form:

    if (!hostForResolve.empty()) {
        char ipBuf[32] = {0};
        const char* ip = nullptr;
        if (aniswitchResolveHost(hostForResolve.c_str(), ipBuf, sizeof(ipBuf)) == 0) {
            ip = ipBuf;
            char _b[160];
            snprintf(_b, sizeof(_b), "HTTP: RESOLVE %s -> %s (raw DNS)",
                     hostForResolve.c_str(), ip);
            aniswitchStartupLog(_b);
        } else {
            char _b[160];
            snprintf(_b, sizeof(_b), "HTTP: RESOLVE %s FAILED (raw DNS)",
                     hostForResolve.c_str());
            aniswitchStartupLog(_b);
        }
        if (ip) {
            session->SetResolve(cpr::Resolve{hostForResolve, ip, {443U}});
        }
    }

The two callers are structurally identical (one for POST, one for
GET); both must be updated.  After this manual fix the
`lookupHardcodedHost` function and the `kHardcodedHosts` table
have no remaining references and the linker is happy.

